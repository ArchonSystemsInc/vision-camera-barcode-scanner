{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["archon", "barcodescanner"],
  "ios": { "iosModuleName": "ArchonBarcodeScanner" },
  "android": {
    "androidNamespace": ["archon", "barcodescanner"],
    "androidCxxLibName": "ArchonBarcodeScanner"
  },
  "autolinking": {
    "ArchonBarcodeScannerFactory": {
      "ios": { "language": "swift", "implementationClassName": "HybridBarcodeScannerFactory" },
      "android": { "language": "kotlin", "implementationClassName": "HybridBarcodeScannerFactory" }
    }
  },
  "ignorePaths": ["**/node_modules", "**/dist"]
}
