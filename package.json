{
  "name": "@archonsystemsinc/vision-camera-barcode-scanner",
  "version": "1.0.0",
  "description": "Viewport-aware barcode scanning for VisionCamera V5 using Apple Vision and ML Kit",
  "author": "Archon Systems <rithik.bhatia@archonsystems.com>",
  "repository": "https://github.com/ArchonSystemsInc/vision-camera-barcode-scanner.git",
  "homepage": "https://github.com/ArchonSystemsInc/vision-camera-barcode-scanner#readme",
  "license": "MIT",
  "type": "module",
  "publishConfig": { "access": "public" },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./src/index.ts",
      "require": "./dist/index.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "docs", "android/src", "android/build.gradle", "android/gradle.properties", "android/CMakeLists.txt", "ios/**/*.swift", "nitrogen", "nitro.json", "react-native.config.cjs", "*.podspec", "NOTICE"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --sourcemap --dts --clean",
    "pack:local": "npm run build && npm pack --pack-destination dist",
    "specs": "nitrogen",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/",
    "prettycheck": "prettier --check src/",
    "prettify": "prettier --write src/",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-native": ">=0.81.0",
    "react-native-nitro-modules": ">=0.35.6",
    "react-native-vision-camera": ">=5.2.3 <6",
    "react-native-vision-camera-worklets": ">=5.2.3 <6",
    "react-native-worklets": ">=0.7.3 <1"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@typescript-eslint/eslint-plugin": "8.10.0",
    "@typescript-eslint/parser": "8.10.0",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-react": "7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-native": "4.1.0",
    "nitrogen": "0.35.6",
    "prettier": "^3.2.5",
    "prettier-plugin-organize-imports": "^3.2.4",
    "react": "19.2.3",
    "react-test-renderer": "19.2.3",
    "react-native": "0.81.4",
    "react-native-nitro-image": "0.15.2",
    "react-native-nitro-modules": "0.35.6",
    "react-native-vision-camera": "5.2.3",
    "react-native-vision-camera-worklets": "5.2.3",
    "react-native-worklets": "0.7.3",
    "tsup": "^8.3.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
